#!/usr/bin/env bash
# Sail in a linked git worktree.
#
# bin/sail sources this file after its environment setup when the current checkout is a linked
# worktree, or for "sail worktree ...". It reuses bin/sail's MACHINE, BOLD, NC, APP_SERVICE,
# WWWUSER, SAIL_DOCKER_BINARY, COMPOSE_CMD, AGENT_ENV_VARS and forward_agent_env, and always exits.
#
# A linked worktree never runs a Sail stack. Each command runs in a throwaway container from the
# app image that mounts the linked worktree, joins the main checkout's network and uses the shared
# services, with a worktree database of its own.
# shellcheck disable=SC2154

function worktree_fail {
    echo "${BOLD}$1${NC}" >&2
    if [ -n "${2:-}" ]; then
        echo "$2" >&2
    fi

    exit 1
}

if ! GIT_DIRS="$(git rev-parse --path-format=absolute --git-dir --git-common-dir 2> /dev/null)"; then
    worktree_fail "Sail worktree commands need a git checkout."
fi

{ read -r GIT_DIR; read -r GIT_COMMON_DIR; } <<< "$GIT_DIRS"
WORKTREE_LIST="$(git worktree list --porcelain)"

if sed '/^$/q' <<< "$WORKTREE_LIST" | grep -qx 'bare'; then
    worktree_fail "Sail in a linked worktree of a bare repository is unsupported." \
        "Sail needs a main checkout that runs the Sail stack."
fi

MAIN_CHECKOUT="$(sed -n '1s/^worktree //p' <<< "$WORKTREE_LIST")"

if [ "$GIT_DIR" == "$GIT_COMMON_DIR" ]; then
    if [ "${2:-}" == "setup" ]; then
        worktree_fail "This is the main checkout: worktree setup runs only in a linked worktree."
    fi

    worktree_fail "Usage: sail worktree setup"
fi

WORKTREE_DIR="$(git rev-parse --show-toplevel)"

if [ "$(pwd -P)" != "$WORKTREE_DIR" ]; then
    worktree_fail "Sail for an application that is not at the root of its git repository is unsupported." \
        "Run Sail from the root of the linked worktree: $WORKTREE_DIR"
fi

# Worktree database: sail_wt_<slug>_<hash8>...
WORKTREE_SLUG="$(printf '%s' "${WORKTREE_DIR##*/}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '_')"
WORKTREE_HASH="$(printf '%s' "$WORKTREE_DIR" | git hash-object --stdin)"
WORKTREE_DATABASE="sail_wt_${WORKTREE_SLUG:0:32}_${WORKTREE_HASH:0:8}"

# Print a variable from the main checkout's env file, loaded the way bin/sail loads it...
function main_env {
    (
        cd "$MAIN_CHECKOUT" || exit 1

        # shellcheck source=/dev/null
        if [ -n "$APP_ENV" ] && [ -f ./.env."$APP_ENV" ]; then
            source ./.env."$APP_ENV"
        elif [ -f ./.env ]; then
            source ./.env
        fi

        printf '%s' "${!1}"
    )
}

# The linked worktree may have no env file yet, so the app service comes from the main checkout...
APP_SERVICE="$(main_env APP_SERVICE)"
DB_CONNECTION="$(main_env DB_CONNECTION)"

# Run Docker Compose for the main checkout...
function main_compose {
    (cd "$MAIN_CHECKOUT" && "${COMPOSE_CMD[@]}" "$@")
}

function sail_stack_not_running {
    worktree_fail "The main checkout's Sail stack is not running: $MAIN_CHECKOUT" \
        "Start it there with: cd \"$MAIN_CHECKOUT\" && ./vendor/bin/sail up -d"
}

# Print the ID of a service's running container in the main checkout's Sail stack...
function running_container {
    local CONTAINER

    CONTAINER="$(main_compose ps --status running -q "$1" 2> /dev/null)"

    if [ -z "$CONTAINER" ]; then
        sail_stack_not_running
    fi

    printf '%s' "$CONTAINER"
}

# Print the ID of the database service's running container...
function database_container {
    local DB_SERVICE

    DB_SERVICE="$(main_env DB_HOST)"
    if [ -z "$DB_SERVICE" ]; then
        worktree_fail "The main checkout's env file sets no DB_HOST database service."
    fi

    running_container "$DB_SERVICE"
}

# Set ARGS to a docker subcommand with stdin attached, and a TTY only when stdin is a terminal and
# NO_TTY is not set...
function interactive_args {
    ARGS=("$@" -i)
    if [ -t 0 ] && [ -z "${NO_TTY:-}" ]; then
        ARGS+=(-t)
    fi
}

# Reads the app service from the main checkout's resolved compose configuration and checks that
# its Sail stack runs. Sets APP_IMAGE, DB_CONTAINER and SERVICE_ARGS (the app service's networks,
# environment and extra hosts as docker run arguments)...
function resolve_sail_stack {
    local CONFIG CACHE ARG PREVIOUS=""

    CONFIG="$(main_compose config --format json 2> /dev/null)" || exit 1

    # "config --images" would also list the app service's dependencies, so read the app image from
    # the canonical JSON, where service keys sit at four spaces and their fields at six...
    APP_IMAGE="$(awk -v service="    \"$APP_SERVICE\": {" '
        $0 == "  \"services\": {" { in_services = 1; next }
        in_services && $0 == service { in_app = 1; next }
        in_app && /^    }/ { exit }
        in_app && sub(/^      "image": "/, "") { sub(/",?$/, ""); print; exit }
    ' <<< "$CONFIG")"

    if [ -z "$APP_IMAGE" ]; then
        worktree_fail "The app service '$APP_SERVICE' in the main checkout's compose configuration has no image."
    fi

    if ! "$SAIL_DOCKER_BINARY" image inspect "$APP_IMAGE" > /dev/null 2>&1; then
        sail_stack_not_running
    fi

    # On sqlite, the Sail stack has no database service...
    if [ "$DB_CONNECTION" != "sqlite" ]; then
        DB_CONTAINER="$(database_container)" || exit 1
    fi

    # Parse the rest of the configuration with PHP inside the app image, so the host needs neither
    # jq nor PHP. The result is cached in the git common dir, keyed by the configuration.
    CACHE="$GIT_COMMON_DIR/sail-worktree/compose-$(printf '%s\n%s' "$APP_SERVICE" "$CONFIG" | git hash-object --stdin)"

    if [ ! -f "$CACHE" ]; then
        mkdir -p "${CACHE%/*}"
        printf '%s' "$CONFIG" | "$SAIL_DOCKER_BINARY" run --rm -i --entrypoint php "$APP_IMAGE" -r '
            $config = json_decode(stream_get_contents(STDIN), true);
            $service = $config["services"][$argv[1]];
            foreach (array_keys($service["networks"] ?? ["default" => null]) as $network) {
                echo "--network\0", $config["networks"][$network]["name"] ?? $network, "\0";
            }
            foreach ($service["environment"] ?? [] as $name => $value) {
                echo "-e\0", $value === null ? $name : "$name=$value", "\0";
            }
            foreach ($service["extra_hosts"] ?? [] as $host) {
                echo "--add-host\0", $host, "\0";
            }
        ' -- "$APP_SERVICE" > "$CACHE.$$" || exit 1
        mv "$CACHE.$$" "$CACHE"
    fi

    SERVICE_ARGS=()
    while IFS= read -r -d '' ARG; do
        SERVICE_ARGS+=("$ARG")

        if [ "$PREVIOUS" == "--network" ] && ! "$SAIL_DOCKER_BINARY" network inspect "$ARG" > /dev/null 2>&1; then
            sail_stack_not_running
        fi

        PREVIOUS="$ARG"
    done < "$CACHE"
}

# Run a command in a throwaway container, with CONTAINER_ARGS as extra docker run arguments...
function run_in_throwaway_container {
    resolve_sail_stack

    interactive_args run --rm
    ARGS+=("${SERVICE_ARGS[@]}")
    ARGS+=(-e "WWWUSER=$WWWUSER" "${CONTAINER_ARGS[@]}")
    if [ "$DB_CONNECTION" != "sqlite" ]; then
        ARGS+=(-e "DB_DATABASE=$WORKTREE_DATABASE")
    fi
    ARGS+=(-e "REDIS_PREFIX=${WORKTREE_DATABASE}_" -e "CACHE_PREFIX=${WORKTREE_DATABASE}_cache_")
    forward_agent_env
    if [ -n "${COLORTERM:-}" ]; then
        ARGS+=(-e "COLORTERM=$COLORTERM")
    fi

    # The main checkout's git dir is mounted at its host path, so git works inside the container.
    ARGS+=(-v "$WORKTREE_DIR:/var/www/html" -v "$GIT_COMMON_DIR:$GIT_COMMON_DIR" -w /var/www/html)

    exec "$SAIL_DOCKER_BINARY" "${ARGS[@]}" "$APP_IMAGE" "$@"
}

# Run a command in a running service container of the main checkout's Sail stack...
function exec_in_container {
    interactive_args exec
    exec "$SAIL_DOCKER_BINARY" "${ARGS[@]}" "$@"
}

# Copy a directory, with reflinks where the filesystem supports them...
function copy_tree {
    if [ "$MACHINE" == "mac" ]; then
        cp -ac "$1" "$2" 2> /dev/null || { rm -rf "$2"; cp -a "$1" "$2"; }
    else
        cp -a --reflink=auto "$1" "$2"
    fi
}

function worktree_setup {
    local FILE DIR

    for FILE in "$MAIN_CHECKOUT"/.env* "$MAIN_CHECKOUT/auth.json"; do
        if [ -f "$FILE" ] && [ ! -e "$WORKTREE_DIR/${FILE##*/}" ]; then
            cp -p "$FILE" "$WORKTREE_DIR/" || exit 1
        fi
    done

    for DIR in vendor node_modules; do
        if [ -d "$MAIN_CHECKOUT/$DIR" ] && [ ! -e "$WORKTREE_DIR/$DIR" ]; then
            copy_tree "$MAIN_CHECKOUT/$DIR" "$WORKTREE_DIR/$DIR" || exit 1
        fi
    done

    case "$DB_CONNECTION" in
        pgsql|mysql|mariadb|sqlite) ;;
        *) worktree_fail "Worktree setup does not support the database driver '$DB_CONNECTION'." ;;
    esac

    resolve_sail_stack

    case "$DB_CONNECTION" in
        pgsql) pgsql_create_database ;;
        mysql|mariadb) mysql_create_database ;;
        sqlite) sqlite_create_database; return ;;
    esac

    echo "${GREEN}Worktree setup complete.${NC} Worktree database: $WORKTREE_DATABASE"
}

# Run SQL in the database service container as the configured user...
function pgsql_query {
    # shellcheck disable=SC2016
    "$SAIL_DOCKER_BINARY" exec -i "$DB_CONTAINER" sh -c 'psql -v ON_ERROR_STOP=1 -qtA -U "$POSTGRES_USER" -d postgres' <<< "$1"
}

function pgsql_create_database {
    if [ "$(pgsql_query "SELECT 1 FROM pg_database WHERE datname = '$WORKTREE_DATABASE'")" != "1" ]; then
        pgsql_query "CREATE DATABASE \"$WORKTREE_DATABASE\"" > /dev/null || exit 1
    fi
}

# Run SQL in the database service container as root, with the mariadb client where the image has
# one (a mariadb service may run under DB_CONNECTION=mysql)...
function mysql_query {
    # shellcheck disable=SC2016
    "$SAIL_DOCKER_BINARY" exec -i "$DB_CONTAINER" sh -c '
        CLIENT=mysql
        command -v mariadb > /dev/null && CLIENT=mariadb
        MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec "$CLIENT" -u root -N -B
    ' <<< "$1"
}

# Create the worktree database as root, and grant the application user the worktree database name
# pattern, so the application can create its own _test_N databases...
function mysql_create_database {
    mysql_query "CREATE DATABASE IF NOT EXISTS \`$WORKTREE_DATABASE\`;
        GRANT ALL PRIVILEGES ON \`sail\\_wt\\_%\`.* TO '$(main_env DB_USERNAME)'@'%';" || exit 1
}

# The sqlite database file stays inside the linked worktree, where Laravel resolves the default or
# a relative or container path...
function sqlite_create_database {
    local FILE

    FILE="$(main_env DB_DATABASE)"
    FILE="${FILE:-database/database.sqlite}"
    FILE="${FILE#/var/www/html/}"

    if [ "${FILE:0:1}" == "/" ]; then
        worktree_fail "The sqlite database '$FILE' is outside the linked worktree." \
            "Leave DB_DATABASE unset, or set it to a path inside the application."
    fi

    if [ ! -e "$WORKTREE_DIR/$FILE" ]; then
        touch "$WORKTREE_DIR/$FILE" || exit 1
    fi

    echo "${GREEN}Worktree setup complete.${NC} Worktree database file: $FILE"
}

CONTAINER_ARGS=()

case "$1" in
    worktree)
        if [ "${2:-}" == "setup" ]; then
            worktree_setup
            exit
        fi

        worktree_fail "Usage: sail worktree setup"
        ;;
    php|composer|cpx|node|npm|npx|pnpm|pnpx|yarn|bun|bunx)
        run_in_throwaway_container "$@"
        ;;
    artisan|art|a)
        shift 1
        if [ "${1:-}" == "schedule:run" ]; then
            NO_TTY=yes
        fi
        run_in_throwaway_container php artisan "$@"
        ;;
    debug)
        shift 1
        CONTAINER_ARGS=(-e XDEBUG_TRIGGER=1)
        run_in_throwaway_container php artisan "$@"
        ;;
    phpunit|pest|pint)
        run_in_throwaway_container php "vendor/bin/$1" "${@:2}"
        ;;
    tinker)
        shift 1
        run_in_throwaway_container php artisan tinker "$@"
        ;;
    shell|bash)
        shift 1
        run_in_throwaway_container bash "$@"
        ;;
    root-shell|root-bash)
        shift 1
        CONTAINER_ARGS=(-e SUPERVISOR_PHP_USER=root)
        run_in_throwaway_container bash "$@"
        ;;
    psql)
        shift 1
        CONTAINER="$(database_container)" || exit 1
        exec_in_container "$CONTAINER" bash -c "PGPASSWORD=\${PGPASSWORD} psql -U \${POSTGRES_USER} $WORKTREE_DATABASE" "$@"
        ;;
    redis|valkey)
        CONTAINER="$(running_container "$1")" || exit 1
        exec_in_container "$CONTAINER" "$1-cli" "${@:2}"
        ;;
    mongodb)
        shift 1
        CONTAINER="$(running_container mongodb)" || exit 1
        exec_in_container "$CONTAINER" mongosh --port 27017 --username "$MONGODB_USERNAME" --password "$MONGODB_PASSWORD" --authenticationDatabase admin "$@"
        ;;
    test)
        shift 1
        run_in_throwaway_container php artisan test "$@"
        ;;
    bin)
        shift 1
        run_in_throwaway_container "./vendor/bin/$1" "${@:2}"
        ;;
    run)
        shift 1
        run_in_throwaway_container "$@"
        ;;
    mysql|mariadb)
        CONTAINER="$(database_container)" || exit 1
        # shellcheck disable=SC2016
        exec_in_container "$CONTAINER" sh -c 'MYSQL_PWD="$MYSQL_PASSWORD" exec "$0" -u "$MYSQL_USER" $MYSQL_EXTRA_OPTIONS "$@"' \
            "$1" "$WORKTREE_DATABASE" "${@:2}"
        ;;
    *)
        worktree_fail "'sail $1' is not available in a linked worktree." \
            "Run it in the main checkout: $MAIN_CHECKOUT"
        ;;
esac
