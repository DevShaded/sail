#!/usr/bin/env bash
# Sail in a linked git worktree.
#
# bin/sail sources this file after its environment setup when the current checkout is a linked
# worktree, or for "sail worktree ...". It reuses bin/sail's MACHINE, BOLD, GREEN, NC, WWWUSER,
# AGENT_ENV_VARS and forward_agent_env, and always exits. Everything about the Sail stack comes
# from the main checkout: its env files, SAIL_FILES and SAIL_DOCKER_BINARY.
#
# A linked worktree never runs a Sail stack. Each command runs in a throwaway container from the
# app image that mounts the linked worktree, joins the main checkout's network and uses the shared
# services, with a worktree database of its own.
# shellcheck disable=SC2154

function worktree_fail {
    echo "${BOLD}$1${NC}" >&2
    if [ -n "${2:-}" ]; then
        echo "$2" >&2
    fi

    exit 1
}

if ! GIT_DIRS="$(git rev-parse --git-dir --git-common-dir 2> /dev/null)"; then
    worktree_fail "Sail worktree commands need a git checkout."
fi

# Resolved with pwd, as git before 2.31 has no "rev-parse --path-format"...
{ read -r WT_GIT_DIR; read -r GIT_COMMON_DIR; } <<< "$GIT_DIRS"
WT_GIT_DIR="$(cd "$WT_GIT_DIR" && pwd -P)" || exit 1
GIT_COMMON_DIR="$(cd "$GIT_COMMON_DIR" && pwd -P)" || exit 1
WORKTREE_LIST="$(git worktree list --porcelain)"

if sed '/^$/q' <<< "$WORKTREE_LIST" | grep -qx 'bare'; then
    worktree_fail "Sail in a linked worktree of a bare repository is unsupported." \
        "Sail needs a main checkout that runs the Sail stack."
fi

MAIN_CHECKOUT="$(sed -n '1s/^worktree //p' <<< "$WORKTREE_LIST")"

# Print the 8-character hash of a linked worktree's absolute path, as used in its worktree database
# name...
function worktree_hash {
    printf '%s' "$1" | git hash-object --stdin | cut -c1-8
}

# The main checkout runs only "sail worktree prune"...
if [ "$WT_GIT_DIR" == "$GIT_COMMON_DIR" ]; then
    case "${2:-}" in
        prune) ;;
        setup) worktree_fail "This is the main checkout: worktree setup runs only in a linked worktree." ;;
        *) worktree_fail "Usage: sail worktree prune" ;;
    esac
else
    WORKTREE_DIR="$(git rev-parse --show-toplevel)"

    if [ "$(pwd -P)" != "$WORKTREE_DIR" ]; then
        worktree_fail "Sail for an application that is not at the root of its git repository is unsupported." \
            "Run Sail from the root of the linked worktree: $WORKTREE_DIR"
    fi

    # Worktree database: sail_wt_<slug>_<hash8>...
    WORKTREE_SLUG="$(printf '%s' "${WORKTREE_DIR##*/}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '_')"
    WORKTREE_DATABASE="sail_wt_${WORKTREE_SLUG:0:32}_$(worktree_hash "$WORKTREE_DIR")"

    # The variables the linked worktree's env files set, which bin/sail has loaded...
    LINKED_ENV_NAMES=()
    while IFS= read -r NAME; do
        LINKED_ENV_NAMES+=("$NAME")
    done < <(sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=.*/\2/p' \
        "$WORKTREE_DIR/.env" ${APP_ENV:+"$WORKTREE_DIR/.env.$APP_ENV"} 2> /dev/null)
fi

# Run a command in the main checkout, without the variables the linked worktree's env files set...
function in_main_checkout {
    (
        cd "$MAIN_CHECKOUT" || exit 1
        unset "${LINKED_ENV_NAMES[@]}" 2> /dev/null
        exec "$@"
    )
}

# Print a variable from the main checkout's env file, loaded the way bin/sail loads it...
function main_env {
    # shellcheck disable=SC2016
    in_main_checkout bash -c '
        # shellcheck source=/dev/null
        if [ -n "$APP_ENV" ] && [ -f ./.env."$APP_ENV" ]; then
            source ./.env."$APP_ENV"
        elif [ -f ./.env ]; then
            source ./.env
        fi

        printf "%s" "${!1}"
    ' bash "$1"
}

# Run Docker Compose for the main checkout, through bin/sail run there...
function main_compose {
    in_main_checkout env SAIL_SKIP_CHECKS=1 "$(dirname "${BASH_SOURCE[0]}")/sail" "$@"
}

# The linked worktree may have no env file yet, so these come from the main checkout...
APP_SERVICE="$(main_env APP_SERVICE)"
APP_SERVICE="${APP_SERVICE:-laravel.test}"
SAIL_DOCKER_BINARY="$(main_env SAIL_DOCKER_BINARY)"
SAIL_DOCKER_BINARY="${SAIL_DOCKER_BINARY:-docker}"
DB_CONNECTION="$(main_env DB_CONNECTION)"

# Exits with 75, so the post-checkout hook can leave phase 2 of worktree setup for later...
function sail_stack_not_running {
    echo "${BOLD}The main checkout's Sail stack is not running: $MAIN_CHECKOUT${NC}" >&2
    echo "Start it there with: cd \"$MAIN_CHECKOUT\" && ./vendor/bin/sail up -d" >&2

    exit 75
}

# Print the ID of a service's running container in the main checkout's Sail stack...
function running_container {
    local CONTAINER

    CONTAINER="$(main_compose ps --status running -q "$1" 2> /dev/null)"

    if [ -z "$CONTAINER" ]; then
        sail_stack_not_running
    fi

    printf '%s' "$CONTAINER"
}

# Print the ID of the database service's running container...
function database_container {
    local DB_SERVICE

    DB_SERVICE="$(main_env DB_HOST)"
    if [ -z "$DB_SERVICE" ]; then
        worktree_fail "The main checkout's env file sets no DB_HOST database service."
    fi

    running_container "$DB_SERVICE"
}

# Set ARGS to a docker subcommand with stdin attached, and a TTY only when stdin is a terminal and
# NO_TTY is not set...
function interactive_args {
    ARGS=("$@" -i)
    if [ -t 0 ] && [ -z "${NO_TTY:-}" ]; then
        ARGS+=(-t)
    fi
}

# Reads the app service from the main checkout's resolved compose configuration and checks that
# its Sail stack runs. Sets APP_IMAGE, DB_CONTAINER and SERVICE_ARGS (the app service's networks,
# environment and extra hosts as docker run arguments)...
function resolve_sail_stack {
    local CONFIG CACHE ARG PREVIOUS=""

    CONFIG="$(main_compose config --format json 2> /dev/null)" || exit 1

    # "config --images" would also list the app service's dependencies, so read the app image from
    # the canonical JSON, where service keys sit at four spaces and their fields at six...
    APP_IMAGE="$(awk -v service="    \"$APP_SERVICE\": {" '
        $0 == "  \"services\": {" { in_services = 1; next }
        in_services && $0 == service { in_app = 1; next }
        in_app && /^    }/ { exit }
        in_app && sub(/^      "image": "/, "") { sub(/",?$/, ""); print; exit }
    ' <<< "$CONFIG")"

    if [ -z "$APP_IMAGE" ]; then
        worktree_fail "The app service '$APP_SERVICE' in the main checkout's compose configuration has no image."
    fi

    if ! "$SAIL_DOCKER_BINARY" image inspect "$APP_IMAGE" > /dev/null 2>&1; then
        sail_stack_not_running
    fi

    # On sqlite, the Sail stack has no database service...
    if [ "$DB_CONNECTION" != "sqlite" ]; then
        DB_CONTAINER="$(database_container)" || exit
    fi

    # Parse the rest of the configuration with PHP inside the app image, so the host needs neither
    # jq nor PHP. The result is cached in the git common dir, keyed by the configuration.
    CACHE="$GIT_COMMON_DIR/sail-worktree/compose-$(printf '%s\n%s' "$APP_SERVICE" "$CONFIG" | git hash-object --stdin)"

    if [ ! -f "$CACHE" ]; then
        mkdir -p "${CACHE%/*}"
        # shellcheck disable=SC2016
        printf '%s' "$CONFIG" | "$SAIL_DOCKER_BINARY" run --rm -i --entrypoint php "$APP_IMAGE" -r '
            $config = json_decode(stream_get_contents(STDIN), true);
            $service = $config["services"][$argv[1]];
            foreach (array_keys($service["networks"] ?? ["default" => null]) as $network) {
                echo "--network\0", $config["networks"][$network]["name"] ?? $network, "\0";
            }
            foreach ($service["environment"] ?? [] as $name => $value) {
                echo "-e\0", $value === null ? $name : "$name=$value", "\0";
            }
            foreach ($service["extra_hosts"] ?? [] as $host) {
                echo "--add-host\0", $host, "\0";
            }
        ' -- "$APP_SERVICE" > "$CACHE.$$" || { rm -f "$CACHE.$$"; exit 1; }
        mv "$CACHE.$$" "$CACHE"
    fi

    SERVICE_ARGS=()
    while IFS= read -r -d '' ARG; do
        SERVICE_ARGS+=("$ARG")

        if [ "$PREVIOUS" == "--network" ] && ! "$SAIL_DOCKER_BINARY" network inspect "$ARG" > /dev/null 2>&1; then
            sail_stack_not_running
        fi

        PREVIOUS="$ARG"
    done < "$CACHE"
}

# Set ARGS to the docker run arguments of a throwaway container, up to its image, with
# CONTAINER_ARGS as extra arguments. Needs a resolved Sail stack...
function throwaway_container_args {
    interactive_args run --rm
    ARGS+=("${SERVICE_ARGS[@]}")
    ARGS+=(-e "WWWUSER=$WWWUSER" "${CONTAINER_ARGS[@]}")
    if [ "$DB_CONNECTION" != "sqlite" ]; then
        ARGS+=(-e "DB_DATABASE=$WORKTREE_DATABASE")
    fi
    ARGS+=(-e "REDIS_PREFIX=${WORKTREE_DATABASE}_" -e "CACHE_PREFIX=${WORKTREE_DATABASE}_cache_")
    forward_agent_env
    if [ -n "${COLORTERM:-}" ]; then
        ARGS+=(-e "COLORTERM=$COLORTERM")
    fi

    # The main checkout's git dir is mounted at its host path, so git works inside the container.
    ARGS+=(-v "$WORKTREE_DIR:/var/www/html" -v "$GIT_COMMON_DIR:$GIT_COMMON_DIR" -w /var/www/html)
}

# Run a command in a throwaway container...
function run_in_throwaway_container {
    ensure_worktree_setup
    resolve_sail_stack
    throwaway_container_args
    exec "$SAIL_DOCKER_BINARY" "${ARGS[@]}" "$APP_IMAGE" "$@"
}

# Run a command in a throwaway container and return its exit code. Needs a resolved Sail stack...
function run_in_setup_container {
    throwaway_container_args
    "$SAIL_DOCKER_BINARY" "${ARGS[@]}" "$APP_IMAGE" "$@"
}

# Run a command in a running service container of the main checkout's Sail stack...
function exec_in_container {
    ensure_worktree_setup
    interactive_args exec
    exec "$SAIL_DOCKER_BINARY" "${ARGS[@]}" "$@"
}

# Copy a directory, with reflinks where the filesystem supports them...
function copy_tree {
    if [ "$MACHINE" == "mac" ]; then
        cp -ac "$1" "$2" 2> /dev/null || { rm -rf "$2"; cp -a "$1" "$2"; }
    else
        cp -a --reflink=auto "$1" "$2"
    fi
}

# Take a lock: a symlink to the holder's PID, which ln creates atomically. A waiter breaks a lock
# whose holder is gone by renaming it to a name of its own, which only one waiter can do. A waiter
# that moved a newer lock than the one it saw puts that lock back...
function acquire_lock {
    local HOLDER MOVED

    mkdir -p "${1%/*}" || exit 1

    until ln -s "$$" "$1" 2> /dev/null; do
        HOLDER="$(readlink "$1" 2> /dev/null)"

        # ps, unlike kill -0, also sees another user's process...
        if [ -n "$HOLDER" ] && ! ps -p "$HOLDER" > /dev/null 2>&1 && mv "$1" "$1.$$" 2> /dev/null; then
            MOVED="$(readlink "$1.$$")"
            rm -f "$1.$$"
            if [ "$MOVED" != "$HOLDER" ]; then
                ln -s "$MOVED" "$1" 2> /dev/null
            fi
            continue
        fi

        sleep 1
    done
}

function release_lock {
    if [ "$(readlink "$1" 2> /dev/null)" == "$$" ]; then
        rm -f "$1"
    fi
}

STATE_DIR="$WT_GIT_DIR/sail-worktree"
SETUP_LOCK="$STATE_DIR/setup.lock"
SETUP_COMPLETE="$STATE_DIR/setup-complete"

# Phase 1 of worktree setup needs no Sail stack: copy what the linked worktree lacks from the main
# checkout. A copied dependency directory is recorded in the state dir, so a later phase 2 knows
# the copy matches the main checkout's lockfile...
function copy_from_main_checkout {
    local FILE DIR

    for FILE in "$MAIN_CHECKOUT"/.env* "$MAIN_CHECKOUT/auth.json"; do
        if [ -f "$FILE" ] && [ ! -e "$WORKTREE_DIR/${FILE##*/}" ]; then
            cp -p "$FILE" "$WORKTREE_DIR/" || exit 1
        fi
    done

    for DIR in vendor node_modules; do
        if [ -d "$MAIN_CHECKOUT/$DIR" ] && [ ! -e "$WORKTREE_DIR/$DIR" ]; then
            copy_tree "$MAIN_CHECKOUT/$DIR" "$WORKTREE_DIR/$DIR" || exit 1
            touch "$STATE_DIR/copied-$DIR" || exit 1
        fi
    done
}

# Phase 2 of worktree setup needs the Sail stack. The linked worktree is set up once its worktree
# database and dependencies are ready; the after-setup step runs after that...
function finish_setup {
    DATABASE_INFO="Worktree database: $WORKTREE_DATABASE"

    check_database_driver
    resolve_sail_stack
    prune_worktree_databases

    case "$DB_CONNECTION" in
        pgsql) pgsql_create_database ;;
        mysql|mariadb) mysql_create_database ;;
        sqlite) sqlite_create_database ;;
    esac

    sync_dependencies

    touch "$SETUP_COMPLETE" || exit 1
    echo "${GREEN}Worktree setup complete.${NC} $DATABASE_INFO"

    run_after_setup_step
}

# Run worktree setup under the linked worktree's lock. "hook": when the Sail stack is down, run only
# phase 1 and leave phase 2 to the first sail command. "lazy": run only if no earlier setup
# finished, which a concurrent command may have done while this one waited for the lock...
function worktree_setup {
    local STATUS=0

    acquire_lock "$SETUP_LOCK"
    trap 'release_lock "$SETUP_LOCK"' EXIT

    if [ "${1:-}" != "lazy" ] || [ ! -e "$SETUP_COMPLETE" ]; then
        copy_from_main_checkout
        # A subshell, so a failure in phase 2 returns here and releases the lock...
        (finish_setup) || STATUS=$?
    fi

    release_lock "$SETUP_LOCK"
    trap - EXIT

    if [ "$STATUS" == "75" ] && [ "${1:-}" == "hook" ]; then
        echo "Worktree setup will finish on the first sail command in this linked worktree once the main checkout's Sail stack runs."
        return 0
    fi

    return "$STATUS"
}

# Before a command, finish worktree setup if no setup has finished yet. A failed after-setup step
# does not stop the command...
function ensure_worktree_setup {
    local STATUS

    if [ -e "$SETUP_COMPLETE" ]; then
        return
    fi

    worktree_setup lazy
    STATUS=$?

    if [ "$STATUS" != "0" ] && [ ! -e "$SETUP_COMPLETE" ]; then
        exit "$STATUS"
    fi
}

# Install dependencies in a throwaway container where the copied ones may not match the linked
# worktree's lockfile: it differs byte-for-byte from the main checkout's, or nothing was copied.
# A lockfile is not installed again until it changes: the last installed copy of each lockfile is
# kept in the linked worktree's git dir...
function sync_dependencies {
    local LOCKFILE DIR INSTALL NODE_LOCKFILE=""

    for LOCKFILE in composer.lock package-lock.json pnpm-lock.yaml yarn.lock bun.lock bun.lockb; do
        [ -f "$WORKTREE_DIR/$LOCKFILE" ] || continue

        if [ "$LOCKFILE" == "composer.lock" ]; then
            DIR=vendor
            INSTALL=(composer install --no-interaction)
        else
            # The first Node lockfile, in the order above, chooses the package manager...
            if [ -n "$NODE_LOCKFILE" ]; then
                continue
            fi
            NODE_LOCKFILE="$LOCKFILE"
            DIR=node_modules
            case "$LOCKFILE" in
                package-lock.json) INSTALL=(npm ci) ;;
                pnpm-lock.yaml) INSTALL=(pnpm install --frozen-lockfile) ;;
                yarn.lock) INSTALL=(yarn install) ;;
                *) INSTALL=(bun install --frozen-lockfile) ;;
            esac
        fi

        if cmp -s "$WORKTREE_DIR/$LOCKFILE" "$STATE_DIR/$LOCKFILE"; then
            continue
        fi

        if [ ! -e "$STATE_DIR/copied-$DIR" ] || ! cmp -s "$WORKTREE_DIR/$LOCKFILE" "$MAIN_CHECKOUT/$LOCKFILE"; then
            echo "${BOLD}Installing dependencies:${NC} ${INSTALL[*]}"
            run_in_setup_container "${INSTALL[@]}" || worktree_fail "Installing dependencies failed: ${INSTALL[*]}"
        fi

        cp "$WORKTREE_DIR/$LOCKFILE" "$STATE_DIR/$LOCKFILE" || exit 1
    done
}

# Run the project's Composer script "sail-worktree-setup" in a throwaway container, if it defines
# one. The linked worktree is already set up, so a failure only makes setup exit non-zero...
function run_after_setup_step {
    # shellcheck disable=SC2016
    if ! run_in_setup_container php -r '
        $scripts = json_decode(file_get_contents("composer.json"), true)["scripts"] ?? [];
        if (! array_key_exists("sail-worktree-setup", $scripts)) {
            exit(0);
        }
        echo "Running the after-setup step: composer run-script sail-worktree-setup\n";
        passthru("composer run-script sail-worktree-setup", $code);
        exit($code);
    '; then
        worktree_fail "The after-setup step failed." \
            "The linked worktree is set up: Sail commands run. Re-run it with: sail worktree setup"
    fi
}

function check_database_driver {
    case "$DB_CONNECTION" in
        pgsql|mysql|mariadb|sqlite) ;;
        *) worktree_fail "Sail in linked worktrees does not support the database driver '$DB_CONNECTION'." ;;
    esac
}

# Drop the worktree databases, with or without a _test_N suffix, of linked worktrees that are gone.
# Needs a resolved Sail stack. Databases are listed before live linked worktrees, so a linked
# worktree created meanwhile keeps its database. A lock in the git common dir serialises prunes.
function prune_worktree_databases {
    local LOCK="$GIT_COMMON_DIR/sail-worktree/prune.lock" STATUS=0

    if [ "$DB_CONNECTION" == "sqlite" ]; then
        return
    fi

    acquire_lock "$LOCK"
    drop_dead_worktree_databases || STATUS=$?
    release_lock "$LOCK"

    if [ "$STATUS" != 0 ]; then
        exit "$STATUS"
    fi
}

function drop_dead_worktree_databases {
    local DATABASES LIVE=" " LINE NAME HASHES HASH

    case "$DB_CONNECTION" in
        pgsql) DATABASES="$(pgsql_query "SELECT datname FROM pg_database WHERE datname LIKE 'sail_wt_%'")" || return 1 ;;
        *) DATABASES="$(mysql_query "SELECT schema_name FROM information_schema.schemata WHERE schema_name LIKE 'sail_wt_%'")" || return 1 ;;
    esac

    # A linked worktree is live when git lists it and its directory exists...
    while IFS= read -r LINE; do
        if [ "${LINE#worktree }" != "$LINE" ] && [ -d "${LINE#worktree }" ]; then
            LIVE+="$(worktree_hash "${LINE#worktree }") "
        fi
    done <<< "$(git worktree list --porcelain)"

    for NAME in $DATABASES; do
        # A name may read both as a worktree database and as a _test_N one; any live hash keeps it.
        HASHES=""
        if [[ "$NAME" =~ ^sail_wt_[a-z0-9_]+_[0-9a-f]{8}$ ]]; then
            HASHES+="${NAME: -8} "
        fi
        if [[ "$NAME" =~ ^(sail_wt_[a-z0-9_]+_[0-9a-f]{8})_test_[0-9]+$ ]]; then
            HASHES+="${BASH_REMATCH[1]: -8} "
        fi
        if [ -z "$HASHES" ]; then
            continue
        fi

        for HASH in $HASHES; do
            if [[ "$LIVE" == *" $HASH "* ]]; then
                continue 2
            fi
        done

        case "$DB_CONNECTION" in
            pgsql) pgsql_query "DROP DATABASE IF EXISTS \"$NAME\" WITH (FORCE)" > /dev/null || return 1 ;;
            *) mysql_query "DROP DATABASE IF EXISTS \`$NAME\`" || return 1 ;;
        esac
        echo "Pruned worktree database: $NAME"
    done
}

# Run SQL in the database service container as the configured user...
function pgsql_query {
    # shellcheck disable=SC2016
    "$SAIL_DOCKER_BINARY" exec -i "$DB_CONTAINER" sh -c 'psql -v ON_ERROR_STOP=1 -qtA -U "$POSTGRES_USER" -d postgres' <<< "$1"
}

function pgsql_create_database {
    if [ "$(pgsql_query "SELECT 1 FROM pg_database WHERE datname = '$WORKTREE_DATABASE'")" != "1" ]; then
        pgsql_query "CREATE DATABASE \"$WORKTREE_DATABASE\"" > /dev/null || exit 1
    fi
}

# Run SQL in the database service container as root, with the mariadb client where the image has
# one (a mariadb service may run under DB_CONNECTION=mysql)...
function mysql_query {
    # shellcheck disable=SC2016
    "$SAIL_DOCKER_BINARY" exec -i "$DB_CONTAINER" sh -c '
        CLIENT=mysql
        command -v mariadb > /dev/null && CLIENT=mariadb
        MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec "$CLIENT" -u root -N -B
    ' <<< "$1"
}

# Create the worktree database as root, and grant the application user the worktree database name
# pattern, so the application can create its own _test_N databases...
function mysql_create_database {
    mysql_query "CREATE DATABASE IF NOT EXISTS \`$WORKTREE_DATABASE\`;
        GRANT ALL PRIVILEGES ON \`sail\\_wt\\_%\`.* TO '$(main_env DB_USERNAME)'@'%';" || exit 1
}

# The sqlite database file stays inside the linked worktree, where Laravel resolves the default or
# a relative or container path...
# Sets DATABASE_INFO to the database file...
function sqlite_create_database {
    local FILE

    FILE="$(main_env DB_DATABASE)"
    FILE="${FILE:-database/database.sqlite}"
    FILE="${FILE#/var/www/html/}"

    if [ "${FILE:0:1}" == "/" ]; then
        worktree_fail "The sqlite database '$FILE' is outside the linked worktree." \
            "Leave DB_DATABASE unset, or set it to a path inside the application."
    fi

    if [ ! -e "$WORKTREE_DIR/$FILE" ]; then
        touch "$WORKTREE_DIR/$FILE" || exit 1
    fi

    DATABASE_INFO="Worktree database file: $FILE"
}

CONTAINER_ARGS=()

case "$1" in
    worktree)
        case "${2:-}" in
            setup)
                # The post-checkout hook passes --hook...
                if [ "${3:-}" == "--hook" ]; then
                    worktree_setup hook
                else
                    worktree_setup
                fi
                ;;
            prune)
                check_database_driver
                if [ "$DB_CONNECTION" != "sqlite" ]; then
                    resolve_sail_stack
                    prune_worktree_databases
                fi
                ;;
            *)
                worktree_fail "Usage: sail worktree setup | sail worktree prune"
                ;;
        esac
        exit
        ;;
    php|composer|cpx|node|npm|npx|pnpm|pnpx|yarn|bun|bunx)
        run_in_throwaway_container "$@"
        ;;
    artisan|art|a)
        shift 1
        if [ "${1:-}" == "schedule:run" ]; then
            NO_TTY=yes
        fi
        run_in_throwaway_container php artisan "$@"
        ;;
    debug)
        shift 1
        CONTAINER_ARGS=(-e XDEBUG_TRIGGER=1)
        run_in_throwaway_container php artisan "$@"
        ;;
    phpunit|pest|pint)
        run_in_throwaway_container php "vendor/bin/$1" "${@:2}"
        ;;
    tinker)
        shift 1
        run_in_throwaway_container php artisan tinker "$@"
        ;;
    shell|bash)
        shift 1
        run_in_throwaway_container bash "$@"
        ;;
    root-shell|root-bash)
        shift 1
        CONTAINER_ARGS=(-e SUPERVISOR_PHP_USER=root)
        run_in_throwaway_container bash "$@"
        ;;
    psql)
        shift 1
        CONTAINER="$(database_container)" || exit 1
        exec_in_container "$CONTAINER" bash -c "PGPASSWORD=\${PGPASSWORD} psql -U \${POSTGRES_USER} $WORKTREE_DATABASE" "$@"
        ;;
    redis|valkey)
        CONTAINER="$(running_container "$1")" || exit 1
        exec_in_container "$CONTAINER" "$1-cli" "${@:2}"
        ;;
    mongodb)
        shift 1
        CONTAINER="$(running_container mongodb)" || exit 1
        # The credentials of the main checkout's mongodb service, which need no linked worktree env file...
        exec_in_container "$CONTAINER" mongosh --port 27017 --username "$(main_env MONGODB_USERNAME)" \
            --password "$(main_env MONGODB_PASSWORD)" --authenticationDatabase admin "$@"
        ;;
    test)
        shift 1
        run_in_throwaway_container php artisan test "$@"
        ;;
    bin)
        shift 1
        run_in_throwaway_container "./vendor/bin/$1" "${@:2}"
        ;;
    run)
        shift 1
        run_in_throwaway_container "$@"
        ;;
    mysql|mariadb)
        CONTAINER="$(database_container)" || exit 1
        # shellcheck disable=SC2016
        exec_in_container "$CONTAINER" sh -c 'MYSQL_PWD="$MYSQL_PASSWORD" exec "$0" -u "$MYSQL_USER" $MYSQL_EXTRA_OPTIONS "$@"' \
            "$1" "$WORKTREE_DATABASE" "${@:2}"
        ;;
    *)
        worktree_fail "'sail $1' is not available in a linked worktree." \
            "Run it in the main checkout: $MAIN_CHECKOUT"
        ;;
esac
